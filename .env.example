# Copiá este archivo a .env.local y completá los valores. Nunca commitees secretos.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# IGDB vía Twitch (https://dev.twitch.tv/console/apps) — solo server-side
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
